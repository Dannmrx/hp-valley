
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Regra temporariamente aberta para depuração.
    // Permite que qualquer usuário autenticado leia e escreva em qualquer lugar.
    // ATENÇÃO: Isso deve ser restringido antes de ir para produção final.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
