rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a coleção 'users'
    match /users/{userId} {
      
      // Permite que um usuário crie seu próprio documento (cadastro).
      // O novo documento deve ter o status 'pending' e isAdmin como 'false'.
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isAdmin == false;

      // Permite que um usuário leia seus próprios dados.
      // Permite que um administrador (isAdmin == true) leia os dados de qualquer usuário.
      allow read: if request.auth != null 
                  && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);

      // Permite que um usuário atualize seus próprios dados, mas não seu status ou permissão de admin.
      // Permite que um administrador atualize o status de qualquer usuário.
      allow update: if request.auth != null && (
        ( // Regra para o próprio usuário
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'passport', 'status', 'isAdmin']) &&
          request.resource.data.isAdmin == resource.data.isAdmin && // Não pode mudar o próprio status de admin
          request.resource.data.status == resource.data.status      // Não pode mudar o próprio status de aprovação
        ) || 
        ( // Regra para o administrador
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
          request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'passport', 'status', 'isAdmin'])
        )
      );
      
      // Não permitir exclusão de usuários via cliente para manter a integridade.
      allow delete: if false;
    }
  }
}
